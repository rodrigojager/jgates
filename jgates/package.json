{
  "name": "@jgates/cli",
  "version": "0.3.0",
  "private": true,
  "description": "JGates: governed quality gates for code approval (CLI, core and local server).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigojager/jgates.git",
    "directory": "jgates"
  },
  "homepage": "https://github.com/rodrigojager/jgates#readme",
  "bugs": {
    "url": "https://github.com/rodrigojager/jgates/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "jgates": "dist/cli/main.js"
  },
  "files": [
    "dist/",
    "skill/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && npm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.js",
    "setup:dev-tools": "node dev-tools/setup.mjs",
    "docs:compat": "node scripts/gen-compat-docs.mjs",
    "test:ui": "npm run build && playwright test --config tests/ui/playwright.config.ts",
    "test:docker": "npm run build && node --test --test-concurrency=1 tests/docker/*.test.js",
    "test:build": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "ajv": "^8.17.1",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recast": "^0.24.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "jscpd": "5.3.3",
    "typescript": "^5.8.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
