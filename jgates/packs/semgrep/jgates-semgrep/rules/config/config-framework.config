<configuration>
  <system.web>
    <!-- ruleid: jgates.config.cookie-without-secure -->
    <httpCookies requireSSL="false" />
    <!-- ok: jgates.config.cookie-without-secure -->
    <httpCookies requireSSL="true" />
    <!-- ruleid: jgates.config.cookie-without-httponly -->
    <httpCookies httpOnlyCookies="false" />
    <!-- ok: jgates.config.cookie-without-httponly -->
    <httpCookies httpOnlyCookies="true" />
    <!-- ruleid: jgates.config.stack-trace-in-response -->
    <customErrors mode="Off" />
    <!-- ok: jgates.config.stack-trace-in-response -->
    <customErrors mode="RemoteOnly" />
    <!-- ruleid: jgates.config.debug-mode-enabled -->
    <compilation debug="true" targetFramework="4.8" />
    <!-- ok: jgates.config.debug-mode-enabled -->
    <compilation debug="false" targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <!-- ruleid: jgates.config.stack-trace-in-response -->
    <httpErrors errorMode="Detailed" />
    <httpProtocol>
      <customHeaders>
        <!-- ruleid: jgates.config.security-headers-disabled -->
        <remove name="X-Frame-Options" />
        <!-- ok: jgates.config.security-headers-disabled -->
        <remove name="X-Powered-By" />
        <!-- ok: jgates.config.security-headers-disabled -->
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
