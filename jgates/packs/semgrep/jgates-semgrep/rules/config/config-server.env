# Fixture of config-server.yaml for the environment-file form of the Spring keys. Never loaded by an application.

# ruleid: jgates.config.tls-old-protocol-version
SERVER_SSL_ENABLED_PROTOCOLS=TLSv1.1,TLSv1.2
# ok: jgates.config.tls-old-protocol-version
SERVER_SSL_ENABLED_PROTOCOLS=TLSv1.3

# ruleid: jgates.config.tls-weak-cipher-suite
SERVER_SSL_CIPHERS=TLS_RSA_WITH_RC4_128_SHA,TLS_AES_128_GCM_SHA256
# ok: jgates.config.tls-weak-cipher-suite
SERVER_SSL_CIPHERS=TLS_AES_128_GCM_SHA256
