<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture of config-server.yaml for the IIS web.config format. Never loaded by IIS. -->
<configuration>
  <system.web>
    <!-- ruleid: jgates.config.version-header-exposed -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="true" />
    <!-- ok: jgates.config.version-header-exposed -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
  </system.web>
  <system.webServer>
    <!-- ruleid: jgates.config.directory-listing-enabled -->
    <directoryBrowse enabled="true" />
    <!-- ok: jgates.config.directory-listing-enabled -->
    <directoryBrowse enabled="false" />
    <security>
      <!-- ruleid: jgates.config.version-header-exposed -->
      <requestFiltering removeServerHeader="false">
        <verbs>
          <!-- ruleid: jgates.config.http-trace-enabled -->
          <add verb="TRACE" allowed="true" />
          <!-- ok: jgates.config.http-trace-enabled -->
          <add verb="TRACE" allowed="false" />
        </verbs>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!-- ruleid: jgates.config.version-header-exposed -->
        <add name="X-Powered-By" value="ASP.NET" />
        <!-- ok: jgates.config.version-header-exposed -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
