{
 "case": "migration-prisma",
 "kind": "clean",
 "tool": "prisma-drift",
 "adapter": "migration-drift",
 "runs": [
  {
   "args": [
    "prisma",
    "migrate",
    "diff",
    "--from-migrations",
    "prisma/migrations",
    "--to-schema",
    "prisma/schema.prisma",
    "--exit-code"
   ],
   "exit": 0,
   "stdout": "No difference detected.\n\n",
   "files": {}
  }
 ]
}
