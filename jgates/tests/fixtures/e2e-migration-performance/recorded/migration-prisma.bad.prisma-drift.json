{
 "case": "migration-prisma",
 "kind": "bad",
 "tool": "prisma-drift",
 "adapter": "migration-drift",
 "runs": [
  {
   "args": [
    "prisma",
    "migrate",
    "diff",
    "--from-migrations",
    "prisma/migrations",
    "--to-schema",
    "prisma/schema.prisma",
    "--exit-code"
   ],
   "exit": 2,
   "stdout": "\n[*] Changed the `User` table\n  [+] Added column `email`\n",
   "files": {}
  }
 ]
}
