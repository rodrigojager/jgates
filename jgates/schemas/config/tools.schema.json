{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jgates.dev/schemas/config/tools.schema.json",
  "title": ".jgates/tools.yml",
  "description": "Tool instances and their bindings to components.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter"
        ],
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "config": {
            "oneOf": [
              {
                "$ref": "#/$defs/pathText"
              },
              {
                "$ref": "#/$defs/fileRef"
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "persona": {
            "description": "zizmor: how strict the audit is (regular: few false positives; pedantic: code smells too; auditor: false positives accepted).",
            "enum": ["regular", "pedantic", "auditor"]
          },
          "minSeverity": {
            "description": "zizmor: the lowest severity that is reported.",
            "enum": ["informational", "low", "medium", "high"]
          },
          "offline": {
            "description": "zizmor: true (the default) never calls the GitHub API; false also runs the audits that need it (a GH_TOKEN is required).",
            "type": "boolean"
          },
          "spec": {
            "description": "oasdiff: the OpenAPI specification to check, relative to the scan root (default: openapi.yaml, openapi.json, swagger.* or the same under api/, docs/, spec/).",
            "$ref": "#/$defs/pathText"
          },
          "baseRef": {
            "description": "oasdiff: the git revision (branch, tag, commit) whose copy of the specification is the reference. Without baseRef or baseSpec the stage is blocked.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/~^@-]*$"
          },
          "baseSpec": {
            "description": "oasdiff: a reference specification file, instead of a git revision.",
            "$ref": "#/$defs/pathText"
          },
          "failOn": {
            "description": "oasdiff: the lowest level of change that blocks (ERR: breaking; WARN: also potentially breaking).",
            "enum": ["ERR", "WARN"]
          },
          "checker": {
            "description": "build-check: which compiler or type checker the instance runs (tsc, mypy, pyright, go, cargo, dotnet). It checks every unit of its stack that carries the project's configuration for it.",
            "enum": ["tsc", "mypy", "pyright", "go", "cargo", "dotnet"]
          },
          "tsconfig": {
            "description": "build-check (tsc): the tsconfig file to pass to tsc -p, relative to the component (default: tsconfig.json).",
            "$ref": "#/$defs/pathText"
          },
          "rulePack": {
            "description": "A rule pack shipped with JGates that the instance runs next to its own rules (semgrep: jgates).",
            "enum": [
              "jgates"
            ]
          },
          "runner": {
            "enum": [
              "local",
              "container"
            ]
          },
          "base": {
            "$ref": "#/$defs/pathText"
          },
          "configFiles": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/fileRef"
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "externalRoots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "path": {
            "$ref": "#/$defs/pathText"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "pathText": {
      "type": "string",
      "minLength": 1
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathText"
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role": {
          "enum": [
            "primary",
            "support",
            "rules",
            "ignore"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write"
          ]
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "$ref": "#/$defs/pathText"
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
