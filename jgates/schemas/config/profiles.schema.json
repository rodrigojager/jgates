{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jgates.dev/schemas/config/profiles.schema.json",
  "title": ".jgates/profiles.yml",
  "description": "The project's profiles: which checks run and how deep. enabled: false turns a check off; null is invalid; absent inherits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "extends": { "type": "string", "minLength": 1 },
          "intensity": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["changed", "full", "paths"] },
          "checks": {
            "type": "object",
            "propertyNames": { "pattern": "^(category|capability|tool|rule|pii|architecture|component):[A-Za-z0-9._/-]+$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "intensity": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
