{
  "schemaVersion": 1,
  "id": "base",
  "label": "Base",
  "description": "Base de qualquer stack: dados pessoais, SAST (Semgrep), segredos (Gitleaks), dependências (OSV-Scanner e Trivy), IaC (Checkov), duplicação (jscpd) e tamanho de arquivo, cada um como uma ferramenta própria na imagem de ferramentas. A ponte com o quality-gate saiu dos planos; o lint e os testes vêm dos templates de cada stack.",
  "config": {
    "workspace": {
      "exclude": [".git/**"]
    },
    "tools": {
      "semgrep": {
        "adapter": "semgrep",
        "enabled": true,
        "rulePack": "jgates",
        "capabilities": ["sast"]
      },
      "gitleaks": {
        "adapter": "gitleaks",
        "enabled": true,
        "capabilities": ["secrets"]
      },
      "osv-scanner": {
        "adapter": "osv-scanner",
        "enabled": true,
        "capabilities": ["dependencies"]
      },
      "trivy": {
        "adapter": "trivy",
        "enabled": true,
        "capabilities": ["dependencies", "iac"]
      },
      "checkov": {
        "adapter": "checkov",
        "enabled": true,
        "capabilities": ["iac"]
      },
      "jscpd": {
        "adapter": "jscpd",
        "enabled": true,
        "capabilities": ["duplication"]
      },
      "file-size": {
        "adapter": "file-size",
        "enabled": true,
        "capabilities": ["file-size"]
      },
      "builtin-pii": {
        "adapter": "builtin-pii",
        "capabilities": ["pii"]
      }
    }
  }
}
