  "governed": {
    "treatment": "self-reported",
    "config": "JGates runs Checkstyle's bundled Sun style (sun_checks.xml); a project configuration is not passed to Checkstyle yet, so the rules are Checkstyle's own",
    "suppressions": {
      "honoured": true,
      "description": "honored: @SuppressWarnings(\"checkstyle:...\") annotations; the Sun style does not enable the comment filters",
      "pattern": "@SuppressWarnings\\s*\\(\\s*\"checkstyle",
      "files": "\\.java$"
    }
  },
  "install": "checkstyle",
  "text": {
    "en": {
      "label": "Checkstyle (Java)",
      "purpose": "A style checker for Java source: Javadoc, naming, whitespace, imports, braces and size limits, under Checkstyle's bundled Sun style.",
      "limitation": "It runs Checkstyle's bundled Sun style; a Checkstyle configuration of the project is not passed to it, and the Sun style is strict about Javadoc and formatting.",
      "needs": "The Java runtime of the tools image and about 512 MB of memory; no network and no project dependencies."
    },
    "pt-BR": {
      "label": "Checkstyle (Java)",
      "purpose": "Um verificador de estilo para código Java: Javadoc, nomes, espaços, imports, chaves e limites de tamanho, com o estilo Sun que o Checkstyle traz.",
      "limitation": "Roda o estilo Sun que o Checkstyle traz; uma configuração de Checkstyle do projeto não é repassada a ele, e o estilo Sun é rígido com Javadoc e formatação.",
      "needs": "O ambiente Java da imagem de ferramentas e cerca de 512 MB de memória; sem rede e sem as dependências do projeto."
    }
